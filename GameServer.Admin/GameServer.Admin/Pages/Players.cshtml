@page
@model PlayersModel
@{
    ViewData["Title"] = "Správa hráčů";
}

<div class="container mt-4">
    <div class="mb-4">
        <h1 class="fw-bold">👥 Seznam a správa hráčů</h1>
        <p class="text-muted">Přehled aktuálně připojených uživatelů, filtrování a správa banů</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger shadow-sm d-flex align-items-center mb-4" role="alert">
            <span class="fs-4 me-3">⚠️</span>
            <div>
                <strong>Chyba komunikace:</strong> @Model.ErrorMessage
            </div>
        </div>
    }

    <div class="card border-0 shadow-sm mb-4 bg-light">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label asp-for="SearchQuery" class="form-label fw-bold">Hledat podle přezdívky:</label>
                    <input asp-for="SearchQuery" class="form-control" placeholder="Zadejte nickname..." />
                </div>
                <div class="col-md-4">
                    <label asp-for="StatusFilter" class="form-label fw-bold">Stav hráče:</label>
                    <select asp-for="StatusFilter" class="form-select">
                        <option value="all">Všichni hráči</option>
                        <option value="online">🟢 Jen Online</option>
                        <option value="offline">⚪ Jen Offline</option>
                        <option value="banned">🔴 Zabanovaní</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100 mb-2">🔍 Hledat a filtrovat</button>
                    <a asp-page="/Players" class="btn btn-outline-secondary w-100">✖ Zrušit filtry</a>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Players != null && Model.Players.Count == 0)
    {
        <div class="alert alert-warning shadow-sm d-flex align-items-center mb-4" role="alert">
            <span class="fs-4 me-3">🔍</span>
            <div>
                <strong>Žádné výsledky!</strong> Tomuto filtru nebo hledání neodpovídá žádný hráč.
            </div>
        </div>
    }

    @if (Model.Players != null && Model.Players.Count > 0)
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 100px;">Status</th>
                            <th>Nickname</th>
                            <th>Level</th>
                            <th>Odezva (Ping)</th>
                            <th>Naposledy spatřen</th>
                            <th class="text-end">Akce</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var player in Model.Players)
                        {
                            <tr class="@(player.IsBanned ? "table-danger" : "")">
                                <td>
                                    @if (player.IsBanned)
                                    {
                                        <span class="badge bg-danger">Banned</span>
                                    }
                                    else if (player.IsOnline)
                                    {
                                        <span class="badge bg-success">Online</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Offline</span>
                                    }
                                </td>

                                <td class="@(player.IsBanned ? "text-decoration-line-through text-muted" : "fw-bold")">
                                    @player.Nickname
                                </td>

                                <td>@player.Level</td>

                                <td>
                                    @if (player.IsOnline && !player.IsBanned)
                                    {
                                        <span class="text-success fw-bold">@player.PingMs ms</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">--</span>
                                    }
                                </td>

                                <td>@(player.LastSeenAt?.ToString("g") ?? "Neznámý")</td>

                                <td class="text-end">
                                    @if (player.IsBanned)
                                    {
                                        <button class="btn btn-sm btn-success">Zrušit ban</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-danger">Zablokovat</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>