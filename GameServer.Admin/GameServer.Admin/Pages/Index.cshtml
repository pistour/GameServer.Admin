@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger shadow-sm d-flex align-items-center mb-4" role="alert">
            <span class="fs-4 me-3">⚠️</span>
            <div>
                <strong>Chyba komunikace:</strong> @Model.ErrorMessage
            </div>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4 bg-light p-3 rounded shadow-sm">
        <div>
            <h1 class="display-5 fw-bold mb-0">Herní Server</h1>
            <p class="text-muted mb-0">Administrace a správa herních instancí</p>
        </div>
        <div>
            @if (Model.Status != null && Model.Status.IsOnline)
            {
                <span class="badge bg-success fs-4 px-3 py-2 rounded-pill shadow-sm">🟢 ONLINE</span>
            }
            else
            {
                <span class="badge bg-danger fs-4 px-3 py-2 rounded-pill shadow-sm">🔴 OFFLINE</span>
            }
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-header bg-primary text-white fw-bold">🎮 Informace o hře</div>
                <div class="card-body">
                    <p class="card-text"><strong>Název:</strong> @(Model.Status?.ServerName ?? "Načítání...")</p>
                    <p class="card-text"><strong>Verze:</strong> 1.20.4</p>
                    <p class="card-text"><strong>Aktuální mapa:</strong> Survival_World_2026</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-header bg-info text-white fw-bold">👥 Online Hráči</div>
                <div class="card-body text-center d-flex flex-column justify-content-center">
                    <h2 class="display-4 fw-bold text-primary">
                        @(Model.Status?.OnlinePlayers ?? 0) / @(Model.Status?.MaxPlayers ?? 0)
                    </h2>

                    @{
                        var percent = 0;
                        if (Model.Status != null && Model.Status.MaxPlayers > 0)
                        {
                            percent = (Model.Status.OnlinePlayers * 100) / Model.Status.MaxPlayers;
                        }
                    }
                    <div class="progress mt-2" style="height: 10px;">
                        <div class="progress-bar bg-success" role="progressbar" style="width: @percent%"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-header bg-dark text-white fw-bold">📜 Zpráva dne (MOTD)</div>
                <div class="card-body">
                    <div class="p-3 bg-light rounded font-monospace border">
                        Welcome to our practicing server! No griefing allowed. Enjoy!
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="text-end mt-4 text-muted small">
        <p>Poslední aktualizace: @DateTime.Now.ToString("g")</p>
    </div>
</div>