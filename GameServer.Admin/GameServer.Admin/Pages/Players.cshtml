@page
@model PlayersModel
@{
    ViewData["Title"] = "Správa hráčů";
}

<div class="container mt-4">
    <div class="mb-4">
        <h1 class="fw-bold">👥 Seznam a správa hráčů</h1>
        <p class="text-muted">Přehled aktuálně připojených uživatelů a správa banů</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger shadow-sm d-flex align-items-center mb-4" role="alert">
            <span class="fs-4 me-3">⚠️</span>
            <div>
                <strong>Chyba komunikace:</strong> @Model.ErrorMessage
            </div>
        </div>
    }
    else if (Model.Players != null && Model.Players.Count == 0)
    {
        <div class="alert alert-info shadow-sm d-flex align-items-center mb-4" role="alert">
            <span class="fs-4 me-3">ℹ️</span>
            <div>
                Aktuálně nejsou na serveru žádní hráči.
            </div>
        </div>
    }

    @if (Model.Players != null && Model.Players.Count > 0)
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 100px;">Status</th>
                            <th>Nickname</th>
                            <th>Level</th>
                            <th>Odezva (Ping)</th>
                            <th>Naposledy spatřen</th>
                            <th class="text-end">Akce</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var player in Model.Players)
                        {
                            <tr class="@(player.IsBanned ? "table-danger" : "")">
                                <td>
                                    @if (player.IsBanned)
                                    {
                                        <span class="badge bg-danger">Banned</span>
                                    }
                                    else if (player.IsOnline)
                                    {
                                        <span class="badge bg-success">Online</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Offline</span>
                                    }
                                </td>

                                <td class="@(player.IsBanned ? "text-decoration-line-through text-muted" : "fw-bold")">
                                    @player.Nickname
                                </td>

                                <td>@player.Level</td>

                                <td>
                                    @if (player.IsOnline && !player.IsBanned)
                                    {
                                        <span class="text-success fw-bold">@player.PingMs ms</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">--</span>
                                    }
                                </td>

                                <td>@(player.LastSeenAt?.ToString("g") ?? "Neznámý")</td>

                                <td class="text-end">
                                    @if (player.IsBanned)
                                    {
                                        <button class="btn btn-sm btn-success">Zrušit ban</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-danger">Zablokovat</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>